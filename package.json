{
	"name": "sveltekit-webmcp",
	"version": "0.0.1",
	"keywords": [
		"svelte",
		"sveltekit",
		"webmcp",
		"mcp",
		"ai",
		"agents",
		"model-context"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./kit": {
			"types": "./dist/kit/index.d.ts",
			"svelte": "./dist/kit/index.js",
			"default": "./dist/kit/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"svelte": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./devtools": {
			"types": "./dist/devtools/index.d.ts",
			"svelte": "./dist/devtools/index.js",
			"default": "./dist/devtools/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"svelte": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./testing/playwright": {
			"types": "./dist/testing/playwright.d.ts",
			"svelte": "./dist/testing/playwright.js",
			"default": "./dist/testing/playwright.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude && eslint .",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@valibot/to-json-schema": "1.8.0",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.12",
		"@w3c/webmcp-polyfill": "0.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"valibot": "1.5.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"webmcp-types": "0.1.11",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.0",
		"@w3c/webmcp-polyfill": "^0.1.0",
		"@playwright/test": "^1.50.0"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	},
	"description": "WebMCP for SvelteKit: expose page tools to AI agents with runes, attachments and remote functions",
	"license": "MIT",
	"author": "Oggy (https://github.com/tsrCodes)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsrCodes/sveltekit-webmcp.git"
	},
	"peerDependenciesMeta": {
		"@w3c/webmcp-polyfill": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		}
	}
}
